#!/usr/bin/env bash
# vm — video-mascot のスクリプトを video-scene と同じ専用の Python で動かす入口
#   vm <コマンド> [引数...]    例: vm voice proj synth / vm render proj --mode alpha / vm overlay main.mp4 proj --out out.mp4
#   コマンド: grid poses parts views voice render overlay
set -uo pipefail
VS_HOME="${VIDEO_SCENE_HOME:-$HOME/.local/share/video-scene}"
PY="$VS_HOME/venv/bin/python"
DIR="$(cd "$(dirname "$0")" && pwd)"
[ $# -ge 1 ] || { sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
cmd="$1"; shift
[ -f "$DIR/$cmd.py" ] || { echo "ERROR: 知らないコマンド: $cmd" >&2; exit 2; }
[ -x "$PY" ] || { echo "ERROR: 道具が入ってない。先に $DIR/setup.sh を実行する" >&2; exit 2; }
exec "$PY" -B "$DIR/$cmd.py" "$@"
